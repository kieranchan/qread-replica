indow !== 'undefined' ? window : globalThis);\n\n</script>\n<script>\n/*\n * 路易斯聚合 — the 时光源 page of the owner's own aggregation platform (server/src/luis/). The wire protocol is the\n * one of sources/langge (search / detail / catalog / content / discovestyle / get_discover / sources/config /\n * get_avatar); the platform list and the tabs come from the backend, so new adapters appear here without a change.\n * Login: 发现页 → 「登录 / 账户」 opens {server}/login (the app keeps the cookies qttoken + deviceId).\n * Settings (source cache, discovery drop-downs): server, tab, source_type, explore_source, sources.\n */\n'use strict';\n\nconst flutterBridge = new FlutterJSBridge();\nconst http = new Http();\nconst cache = new Cache();\nconst cookie = new Cookie();\n\nconst SERVERS = [{ url: 'https://qread.forfine.me/luis', name: '路易斯 主站' }];\nconst DEFAULT_SERVER = SERVERS[0].url;\nconst LOGIN_PATH = '/login?source_client=qyd';\nconst UA = 'Mozilla/5.0 (iPhone; CPU iPhone OS 17_0 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Mobile/15E148 qread-luis';\nconst DEFAULT_TABS = ['小说', '听书', '短剧', '漫画'];\nconst TYPE_OF_TAB = { '小说': 0, '听书': 1, '漫画': 2, '短剧': 4 };\n\nconst enc = encodeURIComponent;\nconst purify = QYD.purifyTitle;\nconst esc = QYD.escapeHtml;\n\nfunction b64e(s) {\n  const bytes = new TextEncoder().encode(String(s));\n  let bin = '';\n  for (let i = 0; i < bytes.length; i++) bin += String.fromCharCode(bytes[i]);\n  return btoa(bin);\n}\n\nfunction b64d(s) {\n  try {\n    const bin = atob(String(s).trim().replace(/-/g, '+').replace(/_/g, '/').replace(/[^A-Za-z0-9+/=]/g, ''));\n    const bytes = new Uint8Array(bin.length);\n    for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);\n    return new TextDecoder().decode(bytes);\n  } catch (e) {\n    return '';\n  }\n}\n\nfunction normServer(v) {\n  return String(v || '').trim().replace(/\\/+$/, '');\n}\n\nfunction isServer(v) {\n  return /^https?:\\/\\/[^/?#]+/i.test(normServer(v));\n}\n\nfunction sourceName(v) {\n  return String(v || '').replace(/^svip_/, '');\n}\n\nasync function getServer() {\n  const s = normServer(await cache.get('server'));\n  return isServer(s) ? s : DEFAULT_SERVER;\n}\n\nasync function allServers() {\n  const list = SERVERS.map((s) => ({ ...s }));\n  const add = (v) => {\n    const url = normServer(v && typeof v === 'object' ? v.url : v);\n    if (!isServer(url) || list.some((s) => s.url === url)) return;\n    list.push({ url, name: (v && v.name) || '自定义' });\n  };\n  const custom = QYD.json(await cache.get('customServers'), []);\n  if (Array.isArray(custom)) custom.forEach(add);\n  add(await cache.get('server'));\n  return list;\n}\n\n/** Login state: the cookies the platform's login page set, else what was cached. */\nasync function getToken() {\n  const servers = [await getServer()].concat((await allServers()).map((s) => s.url));\n  for (const s of servers) {\n    const t = (await cookie.getCookie(s, 'qttoken')) || '';\n    if (t) {\n      const d = (await cookie.getCookie(s, 'deviceId')) || '';\n      await cache.set('qttoken', t);\n      if (d) await cache.set('deviceId', d);\n      return { qttoken: t, deviceId: d };\n    }\n  }\n  return { qttoken: (await cache.get('qttoken')) || '', deviceId: (await cache.get('deviceId')) || '' };\n}\n\nasync function authHeaders() {\n  const t = await getToken();\n  const h = { 'User-Agent': UA };\n  if (t.qttoken) h['Cookie'] = 'qttoken=' + t.qttoken + '; deviceId=' + t.deviceId + ';';\n  return h;\n}\n\nfunction parseJson(resp) {\n  if (!resp) return null;\n  const d = resp.data;\n  if (d && typeof d === 'object') return d;\n  return QYD.json(d, null);\n}\n\nfunction unwrap(j) {\n  if (j && typeof j === 'object' && !Array.isArray(j) && j.data !== undefined) return j.data;\n  return j;\n}\n\n/** GET of one platform url, other servers tried on a transport failure; the raw text goes to the debugger. */\nasync function backendGet(url, debugType, opts) {\n  opts = opts || {};\n  const headers = await authHeaders();\n  const cur = await getServer();\n  const servers = [cur].concat((await allServers()).map((s) => s.url).filter((u) => u !== cur));\n  const tries = opts.retry === false ? [cur] : servers;\n  for (let i = 0; i < tries.length; i++) {\n    const u = i === 0 ? url : url.replace(cur, tries[i]);\n    let resp = null;\n    try {\n      resp = await http.Get(u, headers, true);\n    } catch (e) {}\n    const ok = resp && resp.statusCode >= 200 && resp.statusCode < 300 && resp.data != null && String(resp.data).length > 1;\n    if (ok) {\n      if (debugType != null) flutterBridge.text(debugType, String(resp.data).slice(0, 20000));\n      if (i > 0) {\n        await cache.set('server', tries[i]);\n        flutterBridge.showToast('线路已切换到：' + tries[i]);\n      }\n      return parseJson(resp);\n    }\n    if (resp && resp.statusCode >= 400 && resp.statusCode < 500) {\n      if (debugType != null) flutterBridge.text(debugType, String(resp.data || resp.statusMessage || ''));\n      return parseJson(resp) || { code: -1, msg: 'HTTP ' + resp.statusCode };\n    }\n    flutterBridge.log('请求失败 ' + (resp ? resp.statusCode + ' ' + resp.statusMessage : 'null') + ': ' + u);\n  }\n  return null;\n}\n\nfunction toBook(server, b) {\n  const src = sourceName(b.source);\n  const tab = b.tab || '小说';\n  const url = server + '/detail?book_id=' + b.book_id + '&source=' + enc(src) + '&tab=' + enc(tab);\n  return QYD.book({\n    bookUrl: url,\n    tocUrl: url,\n    name: purify(b.book_name),\n    author: b.author,\n    kind: [b.status, b.score && b.score !== '0' ? String(b.score).replace(/分$/, '') + '分' : '', b.tags || b.category, b.last_chapter_update_time],\n    coverUrl: b.thumb_url,\n    intro: b.abstract,\n    wordCount: b.word_number,\n    type: TYPE_OF_TAB[tab] || 0,\n    latestChapterTitle: src + ':' + (b.latest_chapter_title || b.last_chapter_title || ''),\n  });\n}\n\nfunction toBooks(server, j) {\n  let list = unwrap(j);\n  if (!Array.isArray(list)) list = [];\n  return list.filter((b) => b && b.book_id).map((b) => toBook(server, b));\n}\n\n/** `/sources/config`, cached for an hour: platforms by tier and the tabs each one serves. */\nasync function sourcesConfig(server) {\n  const cached = QYD.json(await cache.get('sources_config'), null);\n  if (cached && cached.at && Date.now() - cached.at < 3600000 && cached.data) return cached.data;\n  const j = await backendGet(server + '/sources/config', null, { retry: false });\n  const d = unwrap(j);\n  if (d && d.modes) {\n    await cache.set('sources_config', JSON.stringify({ at: Date.now(), data: d }));\n    return d;\n  }\n  return cached && cached.data ? cached.data : { free: [], vip: [], svip: [], modes: {} };\n}\n\nfunction platformsOf(config, tab) {\n  const out = [];\n  for (const name of Object.keys(config.modes || {})) if ((config.modes[name] || []).indexOf(tab) >= 0) out.push(name);\n  return out;\n}\n\nfunction tabsOf(config) {\n  const seen = {};\n  for (const name of Object.keys(config.modes || {})) for (const t of config.modes[name] || []) seen[t] = true;\n  const tabs = DEFAULT_TABS.filter((t) => seen[t]);\n  return tabs.length ? tabs : ['小说'];\n}\n\n// ------------------------------------------------------------------ entry points\n\nasync function search(key, page, env) {\n  const server = await getServer();\n  const sources = (await cache.get('sources')) || '全部';\n  const tab = (await cache.get('tab')) || '小说';\n  const url = server + '/search?title=' + enc(key) + '&page=' + (Number(page) || 1) + '&source=' + enc(sources) + '&tab=' + enc(tab) + '&disabled_sources=0';\n  const j = await backendGet(url, 0);\n  if (!j) {\n    flutterBridge.log('搜索失败：' + url);\n    return '[]';\n  }\n  if (j.code !== undefined && j.code !== 0 && j.msg) {\n    flutterBridge.showToast(String(j.msg));\n    return '[]';\n  }\n  if (Array.isArray(j.disabled_sources) && j.disabled_sources.length && (Number(page) || 1) === 1 && !j.cache) {\n    flutterBridge.log('未开通的平台：' + j.disabled_sources.join('、'));\n  }\n  return JSON.stringify(toBooks(server, j));\n}\n\nasync function info(bookurl) {\n  const server = await getServer();\n  const j = await backendGet(bookurl, 1);\n  const d = unwrap(j);\n  if (!d || typeof d !== 'object' || !d.book_id) throw new Error('详情获取失败' + (j && j.msg ? '：' + j.msg : ''));\n  d.source = sourceName(d.source);\n  const tab = d.tab || '小说';\n  const t = await getToken();\n  let account = '未登录（发现页 → 登录 / 账户）';\n  if (t.qttoken) {\n    const u = parseJson(await http.Get(server + '/get_avatar', await authHeaders(), true));\n    account = u && (u.nickname || u.email) ? esc(u.nickname || u.email) + '（已登录）' : '登录已失效，请重新登录';\n  }\n  const rows = [\n    ['数据来源', d.source + ' · ' + tab],\n    ['状态', d.status], ['评分', d.score && d.score !== '0' ? d.score : ''], ['字数', d.word_number],\n    ['标签', d.tags || d.category], ['主角', d.role], ['最新章节', d.last_chapter_title || d.latest_chapter_title], ['更新时间', d.last_chapter_update_time],\n    ['线路', server], ['账户', account],\n  ].filter((r) => r[1]);\n  let intro = '@html:<div style=\"font-size:14px;line-height:1.8;opacity:.92\"><table style=\"border-collapse:collapse;width:100%\">' +\n    rows.map((r) => '<tr><td style=\"padding:2px 8px 2px 0;white-space:nowrap;opacity:.65\">' + esc(r[0]) + '</td><td style=\"padding:2px 0\">' + (r[0] === '账户' ? r[1] : esc(r[1])) + '</td></tr>').join('') +\n    '</table>';\n  if (d.abstract) intro += '<p style=\"margin:10px 0 0;text-indent:2em\">' + esc(String(d.abstract)).replace(/\\n+/g, '<br>') + '</p>';\n  if (d.copyright_info) intro += '<p style=\"margin:8px 0 0;font-size:12px;opacity:.55\">' + esc(String(d.copyright_info)) + '</p>';\n  intro += '</div>';\n  return JSON.stringify(QYD.book({\n    bookUrl: bookurl,\n    name: purify(d.book_name),\n    author: d.author,\n    kind: [d.status, d.score && d.score !== '0' ? d.score + '分' : '', d.tags || d.category, d.last_chapter_update_time],\n    coverUrl: d.thumb_url,\n    intro: intro,\n    tocUrl: b64e(JSON.stringify({ book_id: d.book_id, source: d.source, tab: tab })),\n    wordCount: d.word_number,\n    type: TYPE_OF_TAB[tab] || 0,\n    latestChapterTitle: d.last_chapter_title || d.latest_chapter_title || '',\n  }));\n}\n\nasync function chapter(tocUrl, bookurl) {\n  const server = await getServer();\n  const t = QYD.json(b64d(tocUrl), null);\n  if (!t || !t.book_id) throw new Error('目录地址无效，请先打开详情页');\n  const url = server + '/catalog?book_id=' + t.book_id + '&source=' + enc(sourceName(t.source)) + '&tab=' + enc(t.tab || '小说');\n  const j = await backendGet(url, 2);\n  const list = unwrap(j);\n  if (!Array.isArray(list)) throw new Error('目录获取失败' + (j && j.msg ? '：' + j.msg : ''));\n  return JSON.stringify(list.map((c, i) => QYD.chapter({\n    name: c.title,\n    chapterId: b64e(JSON.stringify({ item_id: c.item_id, source: sourceName(c.source || t.source), tab: c.tab || t.tab, book_id: t.book_id, chapter_title: c.title || '' })),\n    isPay: !!c.is_pay,\n    isVolume: !!c.is_volume,\n  }, i)));\n}\n\nfunction normTitle(v) {\n  return String(v || '').replace(/<[^>]*>/g, '').replace(/[\\s　]+/g, '').toLowerCase();\n}\n\nfunction stripTitle(content, title) {\n  const text = String(content || '');\n  const want = normTitle(title);\n  if (!want) return text;\n  const m = text.match(/^\\s*([^\\n<]{1,120})\\s*\\n?/);\n  if (m && normTitle(m[1]) === want) return text.slice(m[0].length);\n  return text;\n}\n\nasync function content(url, bookurl, index) {\n  const server = await getServer();\n  const c = QYD.json(b64d(url), null);\n  if (!c || typeof c !== 'object' || !c.item_id) throw new Error('章节地址无效');\n  c.source = sourceName(c.source);\n  c.tab = c.tab || '小说';\n  const u = server + '/content?item_id=' + enc(c.item_id) + '&source=' + enc(c.source) + '&tab=' + enc(c.tab) + '&version=5';\n  const j = await backendGet(u, 3);\n  if (!j || typeof j !== 'object') throw new Error('正文获取失败');\n  if (Number(j.code) !== 0) throw new Error('正文获取失败' + (j.msg ? '：' + j.msg : ''));\n  let result = j.content == null ? '' : String(j.content);\n  if (c.tab === '听书' || c.tab === '短剧') return result.trim();\n  if (c.tab === '小说') result = stripTitle(result, c.chapter_title || j.title || '');\n  return result;\n}\n\n// ------------------------------------------------------------------ discovery\n\nconst FILTER_KEYS = { '线路': 'server', '类型': 'tab', '频道': 'source_type', '平台': 'explore_source', '搜索范围': 'sources' };\n\nasync function applyFilter(title) {\n  const key = FILTER_KEYS[title];\n  let v = await cache.get(title);\n  if (!key || v == null || v === '') return;\n  if (title === '线路') {\n    v = normServer(v);\n    if (!isServer(v)) return;\n    await cache.remove('sources_config');\n  }\n  await cache.set(key, v);\n  if (title === '类型') {\n    const config = await sourcesConfig(await getServer());\n    const valid = platformsOf(config, v);\n    const cur = await cache.get('explore_source');\n    if (cur && valid.indexOf(cur) < 0) await cache.set('explore_source', valid[0] || '');\n  }\n  await flutterBridge.refreshExplore();\n}\n\nasync function getfinds() {\n  const server = await getServer();\n  if ((await cache.get('server')) !== server) await cache.set('server', server);\n  const config = await sourcesConfig(server);\n  const tabs = tabsOf(config);\n  let tab = (await cache.get('tab')) || tabs[0];\n  if (tabs.indexOf(tab) < 0) tab = tabs[0];\n  const gender = (await cache.get('source_type')) || '男频';\n  const platforms = platformsOf(config, tab);\n  let platform = (await cache.get('explore_source')) || platforms[0] || '';\n  if (platforms.indexOf(platform) < 0) platform = platforms[0] || '';\n  const sources = (await cache.get('sources')) || '全部';\n  const servers = (await allServers()).map((s) => s.url);\n  const t = await getToken();\n  const all = [].concat(config.free || [], config.vip || [], config.svip || []);\n\n  const entries = [\n    QYD.explore.select('线路', servers, server, \"applyFilter('线路')\"),\n    QYD.explore.select('类型', tabs, tab, \"applyFilter('类型')\"),\n    QYD.explore.select('频道', ['男频', '女频'], gender, \"applyFilter('频道')\"),\n    QYD.explore.select('平台', platforms.length ? platforms : ['（无）'], platform || '（无）', \"applyFilter('平台')\"),\n    QYD.explore.select('搜索范围', ['全部'].concat(all), sources, \"applyFilter('搜索范围')\"),\n    QYD.explore.web(t.qttoken ? '账户中心' : '登录 / 账户', server + (t.qttoken ? '/user' : LOGIN_PATH), 1),\n  ];\n  if (!platform) {\n    entries.push(QYD.explore.title('后端没有提供' + tab + '的平台'));\n    return JSON.stringify(entries);\n  }\n  const j = await backendGet(server + '/discovestyle?source=' + enc(platform) + '&source_type=' + enc(gender) + '&tab=' + enc(tab), null);\n  const list = unwrap(j);\n  if (Array.isArray(list)) {\n    if (j.msg) flutterBridge.showToast(String(j.msg));\n    for (const it of list) {\n      if (!it || !it.title) continue;\n      const half = it.style && it.style.layout_flexBasisPercent === 0.45;\n      const url = String(it.url || '');\n      if (url) entries.push(QYD.explore.list(purify(it.title), url, half ? 1 : Number(it.width) || 0));\n      else entries.push(QYD.explore.title(purify(it.title)));\n    }\n  } else {\n    entries.push(QYD.explore.title('发现页获取失败' + (j && j.msg ? '：' + j.msg : '')));\n  }\n  return JSON.stringify(entries);\n}\n\nasync function find(url, page) {\n  const server = await getServer();\n  url = String(url || '').replace('{{page}}', String(Number(page) || 1));\n  const j = await backendGet(url, 0);\n  if (!j) {\n    flutterBridge.log('发现失败：' + url);\n    return '[]';\n  }\n  if (j.code !== undefined && j.code !== 0 && j.msg) {\n    flutterBridge.showToast(String(j.msg));\n    return '[]';\n  }\n  return JSON.stringify(toBooks(server, j));\n}\n\n// ------------------------------------------------------------------ login / help\n\nasync function getloginurl() {\n  return (await getServer()) + LOGIN_PATH;\n}\n\nasync function login() {\n  await cache.remove('qttoken');\n  await cache.remove('deviceId');\n  await cache.remove('sources_config');\n  return '';\n}\n\nasync function gethelp() {\n  const server = await getServer();\n  const t = await getToken();\n  let who = '未登录';\n  if (t.qttoken) {\n    const u = parseJson(await http.Get(server + '/get_avatar', await authHeaders(), true));\n    who = u && (u.nickname || u.email) ? esc(u.nickname || u.email) : '登录已失效';\n  }\n  const config = await sourcesConfig(server);\n  const tier = (names, label) => (names && names.length ? '<br>' + label + '：' + names.map(esc).join('、') : '');\n  return '@html:<div style=\"font-size:14px;line-height:1.8\">' +\n    '<p><b>路易斯聚合</b></p>' +\n    '<p>线路：' + esc(server) + '<br>账户：' + who + tier(config.free, '免费平台') + tier(config.vip, '登录平台') + tier(config.svip, '会员平台') + '</p>' +\n    '<p>1. 发现页顶部的下拉框设置线路、类型、频道、平台和搜索范围，改完自动刷新。<br>' +\n    '2. 「登录 / 账户」打开平台登录页，登录后返回即可；会员平台需要在用户中心开通会员。<br>' +\n    '3. 搜索默认查询全部可用平台；在「搜索范围」里可以只查一个平台。</p>' +\n    '</div>';\n}\n\n/** Browsing in the app's web view: a 维基文库 work page becomes a book of this source. */\nasync function shouldOverrideUrlLoading(url) {\n  url = String(url || '');\n  const m = url.match(/^https?:\\/\\/zh\\.wikisource\\.org\\/wiki\\/([^?#]+)/);\n  if (!m) return true;\n  let title = '';\n  try {\n    title = decodeURIComponent(m[1]).replace(/_/g, ' ').split('/')[0];\n  } catch (e) {\n    return true;\n  }\n  if (!title || title.indexOf(':') >= 0) return true;\n  const server = await getServer();\n  const target = server + '/detail?book_id=' + b64e(title).replace(/=+$/, '').replace(/\\+/g, '-').replace(/\\//g, '_') + '&source=' + enc('维基文库') + '&tab=' + enc('小说');\n  flutterBridge.showToast('添加书籍到书架：' + title);\n  flutterBridge.addbook(target);\n  return false;\n}\n</script>\n</html>\n"}]